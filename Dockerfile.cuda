# Тяжёлый образ: LSB, LF-VSN и SteganoGAN, CPU или NVIDIA GPU.
#
#   docker build -f Dockerfile.cuda -t stego:heavy .
#
#   # UI с GPU (веса монтируются из репозитория):
#   docker run --rm --gpus all -p 8501:8501 \
#       -v "$(pwd)/stego/engines/lfvsn/weights:/app/stego/engines/lfvsn/weights" \
#       -v "$(pwd)/stego/engines/steganogan/weights:/app/stego/engines/steganogan/weights" \
#       stego:heavy
#
# Без --gpus контейнер всё равно запустится и будет считать на CPU (device=auto).
# Веса (*.pth, *.steg) исключены из образа через .dockerignore — монтируйте в рантайме.
# Linux-колесо PyTorch уже включает CUDA-библиотеки: отдельный CUDA runtime
# в базовом образе дублировал бы их. Драйвер GPU передаётся через --gpus all.
FROM python:3.12-slim-bookworm

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY stego ./stego

# Оба нейросетевых extra нужны: SteganoGAN дополнительно использует reedsolo.
RUN uv sync --extra ui --extra lfvsn --extra steganogan --frozen --no-cache --no-editable --no-dev
ENV PATH="/app/.venv/bin:$PATH"

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Веса не бэйкятся в образ (они в .dockerignore) — монтируйте директорию с ними в рантайме:
#   -v "$PWD/weights:/app/stego/engines/lfvsn/weights"  или через LFVSN_WEIGHTS
EXPOSE 8501
ENTRYPOINT ["/entrypoint.sh"]
